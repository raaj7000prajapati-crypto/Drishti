# ==========================================
# DRISHTI AICTE - Environment Configuration
# ==========================================

# Secret key for JWT signing (use a strong random value in production)
SECRET_KEY=drishti-aicte-super-secure-secret-key-sih-2026

# Database Connection
# PostgreSQL in Docker: postgresql+psycopg2://drishti:drishti123@localhost:5432/drishtidb
# Local Development: sqlite:///./drishti.db
DATABASE_URL=postgresql+psycopg2://drishti:drishti123@localhost:5432/drishtidb

# File Storage Volume
STORAGE_DIR=./uploads

# MailHog / SMTP Server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@drishti.aicte.gov.in

# AI Correlation Thresholds
SIMILARITY_HIGH_THRESHOLD=0.80
SIMILARITY_MEDIUM_THRESHOLD=0.50
SIMILARITY_LOW_THRESHOLD=0.30

# SLA Resolution Deadlines (in days)
SLA_URGENT_DAYS=1
SLA_HIGH_DAYS=3
SLA_MEDIUM_DAYS=7
SLA_LOW_DAYS=14
