# ==========================================
# DRISHTI AICTE - Environment Configuration
# ==========================================

# Secret key for JWT signing (use a strong random value in production)
SECRET_KEY=drishti-aicte-super-secure-secret-key-sih-2026
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
# PostgreSQL in Docker: postgresql+psycopg2://drishti:drishti123@localhost:5432/drishtidb
# Local Development: sqlite:///./drishti.db
DATABASE_URL=postgresql+psycopg2://drishti:drishti123@localhost:5432/drishtidb

# File Storage Volume
STORAGE_DIR=./uploads

# MailHog / SMTP Server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@drishti.aicte.gov.in

# AI Correlation Thresholds
SIMILARITY_HIGH_THRESHOLD=0.80
SIMILARITY_MEDIUM_THRESHOLD=0.50
SIMILARITY_LOW_THRESHOLD=0.30
SIMILARITY_TFIDF_WEIGHT=0.35
SIMILARITY_EMBEDDING_WEIGHT=0.65
SIMILARITY_MULTILINGUAL_ENABLED=true
SIMILARITY_ENGLISH_MODEL=all-MiniLM-L6-v2
SIMILARITY_MULTILINGUAL_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Increment when changing model weights to invalidate cached complaint embeddings.
SIMILARITY_EMBEDDING_CACHE_VERSION=1

# SLA Resolution Deadlines (in days)
SLA_URGENT_DAYS=1
SLA_HIGH_DAYS=3
SLA_MEDIUM_DAYS=7
SLA_LOW_DAYS=14
